# Database (required – same DB as app)
DATABASE_URL="mysql://user:password@127.0.0.1:3306/food_delivery"

# Server
PORT=3001

# Auth – must match food-delivery-app .env so JWT works across app ↔ server
JWT_SECRET=your-secret-key-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# CORS – comma-separated origins (e.g. app URL). Empty = allow localhost:3000, 127.0.0.1:3000
# CORS_ORIGIN=http://localhost:3000

# Frontend origin for OAuth callback postMessage (app URL)
# FRONTEND_ORIGIN=http://localhost:3000

# Server public URL for OAuth redirect_uri (e.g. http://localhost:3001). Used for Google callback URL.
# API_URL=http://localhost:3001

# SMTP for password reset emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# APP_NAME=HanalaFood

# Google OAuth (for sign-in with Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
