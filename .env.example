# Copy to `.env` — do not commit secrets.

DATABASE_URL="mysql://user:password@127.0.0.1:3306/food_delivery"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
JWT_SECRET=your-secret-key-min-32-chars
OTP_SECRET=your-otp-secret-min-32-bytes

PORT=3001
# Comma-separated browser origins allowed by NestJS CORS (must match your Next app URL)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# FRONTEND_ORIGIN=http://localhost:3000
# API_URL=http://localhost:3001

============== SMTP CONFIGURATION =============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# APP_NAME=HanalaFood

============== GOOGLE OAUTH CONFIGURATION =============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_IMAGE_URL=

============== CLOUDINARY CONFIGURATION =============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_UPLOAD_FOLDER=hanala/avatars
CLOUDINARY_API_SECRET=
REDIS_URL=redis://:password@127.0.0.1:6379

============== RABBITMQ CONFIGURATION =============
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

============== STRIPE CONFIGURATION =============
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
APP_URL=http://localhost:3000
ITEM_ORDER_VALUE_LIMIT=100

============= VNPAY CONFIGURATION =============
VNP_TMNCODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/checkout/vnpay-return
VNP_IPN_URL=https://your-api.example.com/api/webhooks/vnpay/ipn
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_FX_USD_QUOTE_URLS=https://api.exchangerate-api.com/v4/latest/USD,https://open.er-api.com/v6/latest/USD
VNP_FX_CACHE_TTL_MS=3600000
# Optional: VND per 1 USD if all FX URLs fail
# VNP_USD_TO_VND_RATE=25000
